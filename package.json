{
  "name": "pixeldoro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "eslint .",
    "test": "vitest run && pnpm --filter @pixeldoro/mobile run test:device",
    "test:coverage": "vitest run --coverage",
    "test:boundaries": "node scripts/validate-boundaries.mjs",
    "quality": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:boundaries && pnpm run check:repository",
    "start": "pnpm --filter @pixeldoro/mobile start",
    "prebuild": "pnpm --filter @pixeldoro/mobile exec expo prebuild",
    "ios": "pnpm prebuild && pnpm --filter @pixeldoro/mobile ios",
    "android": "pnpm prebuild && pnpm --filter @pixeldoro/mobile android",
    "build:mobile": "node scripts/run-mobile-build.mjs build:interactive",
    "update:mobile:manifest": "node scripts/run-mobile-update.mjs manifest",
    "update:mobile": "node scripts/run-mobile-update.mjs source",
    "eas:update:dev": "node scripts/run-mobile-update.mjs fast --target development",
    "eas:update:stg": "node scripts/run-mobile-update.mjs fast --target staging",
    "eas:update:prd": "node scripts/run-mobile-update.mjs fast --target production",
    "build:android:prd:local": "node scripts/run-mobile-build.mjs build:android:prd:local",
    "build:ios:prd:local": "node scripts/run-mobile-build.mjs build:ios:prd:local",
    "build:android:prd": "node scripts/run-mobile-build.mjs build:android:prd",
    "build:ios:prd": "node scripts/run-mobile-build.mjs build:ios:prd",
    "mobile": "pnpm --filter @pixeldoro/mobile",
    "mobile:doctor": "pnpm --filter @pixeldoro/mobile run doctor",
    "check:repository": "node scripts/check-repository.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
