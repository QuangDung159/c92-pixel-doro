{
  "cli": {
    "version": ">= 22.6.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "credentialsSource": "remote",
      "node": "22.23.2"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "credentialsSource": "remote",
      "node": "22.23.2"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "credentialsSource": "remote",
      "node": "22.23.2"
    }
  },
  "submit": {
    "preview": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}

